ROBOTOPS_ENV=prod
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-me
# Optional
REDIS_URL=redis://redis:6379/0
# Only needed if the frontend is served from a different origin (comma-separated). Leave empty otherwise.
CORS_ORIGINS=
MAX_BODY_BYTES=1000000
LOGIN_MAX_FAILS=5
# Access-token lifetime in minutes (1-1440)
JWT_TTL_MINUTES=60
# If set, GET /metrics requires "Authorization: Bearer <token>" (Prometheus: authorization.credentials)
METRICS_TOKEN=
# Per-device ingestion rate limit
DEVICE_RATE_PER_MIN=600
# A running job whose worker has not heartbeated for this long is re-queued
WORKER_LEASE_SECONDS=60
